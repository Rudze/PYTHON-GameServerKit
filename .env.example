# Copy this file to .env and change the values. Never commit .env.

# --- Shared by the API and the game server ---
# postgresql://user:password@host:port/database
DATABASE_URL=postgresql://game:change-me@127.0.0.1:5432/game
DB_POOL_MIN=2
DB_POOL_MAX=10
# A long random secret, the same for the API and every game server:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_SECONDS=86400
LOG_LEVEL=INFO

# --- API (python -m api) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Game server (python -m server) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5001
# Name in the server list (unique per game server)
SERVER_NAME=main
# Address the clients use to reach this game server (a domain or a public IP in production)
SERVER_PUBLIC_HOST=127.0.0.1
SERVER_MAX_PLAYERS=100
# Folder holding game.json and items.json (default: ./data)
# DATA_DIR=./data
# true: refuse the clients whose game data (content hash) differs from the server's
REQUIRE_CONTENT_HASH=false
# Seconds between a change and its save (the changes in between are saved together)
AUTOSAVE_DELAY=2.0
